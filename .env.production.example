# Copy this file to `.env.production` before `npm run electron:build`.
# Vite bakes these values into the bundle — required for Quick Match / Host / Join in the EXE.

# PartyKit WebSocket host — NO https:// or wss:// (e.g. my-room.myuser.partykit.dev)
VITE_PARTYKIT_HOST=

# Optional: self-hosted relay instead of or in addition to PartyKit
# VITE_PVP_RELAY_URL=wss://your-relay.example/ws
