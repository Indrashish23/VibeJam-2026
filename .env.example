# PartyKit WebSocket host (no protocol). Dev: localhost:1999 after `npm run party:dev`
VITE_PARTYKIT_HOST=localhost:1999

# Optional PvP / WebRTC relay — see src/net/transportConfig.ts
# VITE_PVP_RELAY_URL=wss://...

# Desktop EXE: copy this file to `.env.production` before `npm run electron:build` so multiplayer
# endpoints match your deployed game (Vite bakes VITE_* at build time). See docs/desktop-build.md.

# Set to `true` so the Tweaks panel (T / −) is included when `VITE_PUBLIC_BUILD=true` (e.g. Vercel prod).
# VITE_ENABLE_TWEAKS=true

# Bug report: override default Ragebait feedback form + optional prefill entry id — see docs/bug-report-google-form.md
# VITE_BUG_REPORT_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSe9CAqUeIBrjXjhuZZlf5J-APZ7Nff88pUfVCqSEVm72obA7w/viewform
# VITE_BUG_FORM_ENTRY_CONTEXT=entry.1234567890

# Webring: “Enter portal” navigates here with ?username=&color=&speed=&ref= — hub routes to the next game.
# VITE_VIBEJAM_PORTAL_URL=https://vibejam.cc/portal/2026
